# Copy to .env (never commit .env). Every value is optional in development.
SYNAPTO_ENV=development
SYNAPTO_CORS_ORIGINS=["http://localhost:3000"]
SYNAPTO_DATABASE_URL=sqlite:///./synapto.db
# REQUIRED outside development. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNAPTO_JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying

# ---- Cloud providers (server-wide keys; users can also add their own in Settings -> API keys) ----
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# Key used to encrypt per-user API keys stored in the database. If unset, one is created once at
# ./data/.secret_key (mode 600, never overwritten). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SYNAPTO_ENCRYPTION_KEY=

# Model IDs (verified 2026-10-13; providers retire IDs often, so these are configurable).
# deepseek-chat / deepseek-reasoner and gemini-1.5-pro / gemini-2.0-flash are RETIRED.
SYNAPTO_DEEPSEEK_CHAT_MODEL=deepseek-flash
SYNAPTO_DEEPSEEK_REASONER_MODEL=deepseek-flash
SYNAPTO_DEEPSEEK_REASONING_EFFORT=high
SYNAPTO_GEMINI_PRO_MODEL=gemini-3.1-pro-preview
SYNAPTO_GEMINI_FLASH_MODEL=gemini-3.5-flash

# ---- Routing and limits ----
SYNAPTO_AUTO_ORDER=["deepseek:chat","gemini:pro","gemini:flash"]   # Ollama is always last
SYNAPTO_ROUTE_REASONING=true
SYNAPTO_FALLBACK_DEFAULT=true
SYNAPTO_LOCAL_FALLBACK=true
SYNAPTO_PROVIDER_MAX_RETRIES=1
SYNAPTO_PROVIDER_FIRST_TOKEN_TIMEOUT_S=45
SYNAPTO_PROVIDER_STALL_TIMEOUT_S=30

# ---- Local services (optional) ----
SYNAPTO_OLLAMA_URL=http://127.0.0.1:11434
SYNAPTO_CHAT_MODEL=llama3.2
SYNAPTO_NUM_CTX=8192
SYNAPTO_DATA_DIR=./data
SYNAPTO_EMBED_MODEL=bge-m3
# SYNAPTO_SEARXNG_URL=http://127.0.0.1:8080
# SYNAPTO_IMAGEGEN_URL=http://127.0.0.1:7860
# SYNAPTO_WHISPER_MODEL=small
